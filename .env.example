# Copy to .env and fill in your own values. Never commit the real .env file.

SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_USERNAME=your-readonly-api-user
SERVICENOW_PASSWORD=

GMAIL_SMTP_USER=your-workspace-account@yourdomain.com
GMAIL_SMTP_APP_PASSWORD=

ALERT_RECIPIENT_EMAIL=team@yourdomain.com

POLL_INTERVAL_MINUTES=5
STALE_THRESHOLD_HOURS=24

# --- Added with the review-feedback changes (these live in the n8n Config node; listed here for reference) ---
# Base URL of the acknowledgement link in alert emails. Must be reachable by the people who read the email.
ACK_BASE_URL=http://localhost:5678/webhook/servicenow-incident-ack
# Escalation: emailed (in addition to ALERT_RECIPIENT_EMAIL) when a critical alert is still unacknowledged
ESCALATION_L1_MINUTES=30
ESCALATION_L1_RECIPIENT=oncall-manager@yourdomain.com
ESCALATION_L2_MINUTES=60
ESCALATION_L2_RECIPIENT=engineering-director@yourdomain.com
# Pagination
SERVICENOW_PAGE_SIZE=200
SERVICENOW_MAX_PAGES=50
