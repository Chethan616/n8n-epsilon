{
  "name": "ServiceNow Monitor - Error Handler",
  "nodes": [
    {
      "parameters": {},
      "id": "e1",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "fromEmail": "your-workspace-account@yourdomain.com",
        "toEmail": "admin@yourdomain.com",
        "subject": "=[n8n] {{ $json.workflow.name }} failed",
        "emailFormat": "text",
        "text": "=Workflow: {{ $json.workflow.name }}\nFailed node: {{ $json.execution.lastNodeExecuted }}\nError: {{ $json.execution.error.message }}\nExecution: {{ $json.execution.url }}\n",
        "options": {}
      },
      "id": "e2",
      "name": "Email Administrator",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        220,
        0
      ],
      "credentials": {
        "smtp": {
          "id": "",
          "name": "Gmail SMTP"
        }
      }
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Email Administrator",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
