    {
      "parameters": {
        "jsCode": "// One-time setup: emit the run-lock row only if it does not exist yet, so re-running Setup is safe.\nconst existing = $input.all().some((i) => i.json && i.json.dedup_key === '__run_lock__');\nif (existing) return [];\nreturn [\n  {\n    json: {\n      dedup_key: '__run_lock__',\n      status: 'lock',\n      claim_id: null,\n      claimed_at: '1970-01-01T00:00:00.000Z',\n      version: 1,\n    },\n  },\n];\n"
      },
